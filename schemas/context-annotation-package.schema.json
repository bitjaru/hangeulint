{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitjaru/hangeulint/schemas/context-annotation-package.schema.json",
  "title": "HangeuLint KoContextBench blind annotation package",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "package_id",
    "dataset_id",
    "gold_included",
    "case_ids_included",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "engine_version": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "gold_included": {"const": false},
    "case_ids_included": {"const": false},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "annotation_id",
          "domain",
          "task",
          "source_context",
          "candidate",
          "questions"
        ],
        "properties": {
          "annotation_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "source_context": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "questions": {
            "type": "object",
            "required": [
              "status",
              "finding_ids",
              "actor_resolution",
              "rationale_required"
            ],
            "properties": {
              "status": {
                "type": "array",
                "items": {"enum": ["pass", "review", "fail"]},
                "uniqueItems": true
              },
              "finding_ids": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "actor_resolution": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "rationale_required": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
