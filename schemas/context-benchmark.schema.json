{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitjaru/hangeulint/schemas/context-benchmark.schema.json",
  "title": "HangeuLint KoContextBench dataset",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "release_level",
    "license",
    "annotation_policy",
    "contracts",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "release_level": {
      "enum": ["development_seed", "public_calibration", "private_holdout"]
    },
    "license": {"type": "string", "minLength": 1},
    "annotation_policy": {
      "type": "object",
      "required": [
        "required_raters",
        "adjudication_required",
        "blind_review",
        "pre_registered",
        "independent_holdout"
      ],
      "properties": {
        "required_raters": {"type": "integer", "minimum": 1},
        "adjudication_required": {"type": "boolean"},
        "blind_review": {"type": "boolean"},
        "pre_registered": {"type": "boolean"},
        "independent_holdout": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "context-contract.schema.json"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "phenomena",
          "contract_id",
          "source_context",
          "candidate",
          "source",
          "gold",
          "annotations"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "phenomena": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "contract_id": {"type": "string", "minLength": 1},
          "source_context": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": [
              "kind",
              "license",
              "reference",
              "redistribution_allowed"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "first_party_synthetic",
                  "public_licensed",
                  "customer_opt_in"
                ]
              },
              "license": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "redistribution_allowed": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "gold": {
            "type": "object",
            "required": ["status", "finding_ids", "actor_resolution"],
            "properties": {
              "status": {"enum": ["pass", "review", "fail"]},
              "finding_ids": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "actor_resolution": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "annotations": {
            "type": "object",
            "required": ["completed_raters", "adjudicated", "agreement"],
            "properties": {
              "completed_raters": {"type": "integer", "minimum": 0},
              "adjudicated": {"type": "boolean"},
              "agreement": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
