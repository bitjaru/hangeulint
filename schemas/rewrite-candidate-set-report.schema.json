{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bitjaru/hangeulint/schemas/rewrite-candidate-set-report.schema.json",
  "title": "HangeuLint rewrite candidate set report",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "set_id",
    "source_sha256",
    "pack",
    "contract_id",
    "passed",
    "gate",
    "eligible_candidate_ids",
    "candidates",
    "diversity",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "engine_version": {"type": "string", "minLength": 1},
    "set_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pack": {"type": "string", "minLength": 1},
    "contract_id": {"type": ["string", "null"]},
    "passed": {"type": "boolean"},
    "gate": {
      "type": "object",
      "required": [
        "candidates",
        "eligible",
        "rejected",
        "review",
        "strict_review",
        "strict_diversity",
        "diversity_blocked"
      ],
      "properties": {
        "candidates": {"type": "integer", "minimum": 1},
        "eligible": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "strict_review": {"type": "boolean"},
        "strict_diversity": {"type": "boolean"},
        "diversity_blocked": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "eligible_candidate_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "strategy",
          "hypothesis_ids",
          "generator",
          "candidate_sha256",
          "status",
          "eligible",
          "requires_review",
          "gates",
          "finding_ids",
          "metrics"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "strategy": {"type": "string", "minLength": 1},
          "hypothesis_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "generator": {"type": "object"},
          "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["eligible", "review", "rejected"]},
          "eligible": {"type": "boolean"},
          "requires_review": {"type": "boolean"},
          "gates": {"type": "object"},
          "finding_ids": {"type": "object"},
          "metrics": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "diversity": {"$ref": "diversity-report.schema.json"},
    "privacy": {
      "type": "object",
      "required": [
        "persisted_by_core",
        "contains_source_text",
        "contains_candidate_text",
        "contains_recent_output_text"
      ],
      "properties": {
        "persisted_by_core": {"const": false},
        "contains_source_text": {"const": false},
        "contains_candidate_text": {"const": false},
        "contains_recent_output_text": {"const": false}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
