    },
    {
      "id": "social.uniform-endings",
      "kind": "repeated_ending",
      "dimension": "naturalness",
      "category": "rhythm",
      "severity": "warning",
      "confidence": "medium",
      "message": "같은 종결어미가 이어져 리듬이 단조롭습니다.",
      "suggestion": "문장 길이와 종결 방식을 의미에 맞게 조정하세요.",
      "options": {
        "min_sentences": 4,
        "ratio": 0.75,
        "suffixes": ["습니다", "입니다", "합니다", "됩니다", "어요", "예요", "죠", "다"]
