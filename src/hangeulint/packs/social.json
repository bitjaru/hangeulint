  "rules": [
    {
      "id": "social.fragmented-lines",
      "kind": "short_line_ratio",
      "dimension": "task_fit",
      "category": "layout-rhythm",
      "severity": "error",
      "confidence": "high",
      "message": "짧은 줄이 연속되어 본문이 카드뉴스처럼 끊깁니다.",
      "suggestion": "의도된 시나 카피가 아니라면 문장과 의미 단위로 연결하세요.",
      "options": {
        "min_lines": 4,
        "max_compact_chars": 18,
        "ratio": 0.7
